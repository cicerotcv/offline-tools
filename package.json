    "@tanstack/react-router-devtools": "^1.142.8",
    "@tanstack/router-vite-plugin": "^1.142.8",
    "@types/bip38": "^3.1.2",
    "bip32": "^5.0.0",
    "bip38": "^3.1.1",
    "bip39": "^3.1.0",
