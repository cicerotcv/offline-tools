{
  "name": "offline-tools",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/generate-static-pages.ts",
    "build:single": "tsc -b && VITE_SINGLE_FILE=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier:fix": "prettier --write src/**/*.{ts,tsx}",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=preview",
    "test:e2e:single": "pnpm build:single && playwright test --project=single",
    "release": "scripts/release.sh",
    "test:e2e:static": "pnpm build && playwright test --project=static",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
